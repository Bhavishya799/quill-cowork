# Copy this file to .env and fill in your values.

# ---------- Provider ----------
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# ---------- Model slots ----------
# Three slots the user can switch between from the UI.
# Swap these for any Ollama model you have installed.
MODEL_FAST=qwen2.5:3b
MODEL_BALANCED=quill
MODEL_POWERFUL=qwen2.5:7b
DEFAULT_SLOT=balanced

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
MAX_TOOL_ITERATIONS=8

# ---------- Credentials ----------
# Never commit real secrets. Use the vault instead:
#   python vault.py set GITHUB_PERSONAL_ACCESS_TOKEN ghp_xxx
GITHUB_PERSONAL_ACCESS_TOKEN=