# Copy this file to .env and fill in your values.

# ---------- Provider ----------
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# ---------- Model slots ----------
MODEL_FAST=qwen2.5:3b
MODEL_BALANCED=quill
MODEL_POWERFUL=richardyoung/granite-4.2-8b-heretic
MODEL_CPU_FAST=quill-cpu-fast
MODEL_CPU_SMART=quill-cpu-smart
DEFAULT_SLOT=balanced

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
MAX_TOOL_ITERATIONS=20

# ---------- Filesystem ----------
WORKSPACE_ROOT=D:/Quill-Cowork/workspace

# ---------- Network ----------
ALLOWED_DOMAINS=

# ---------- Safety ----------
DISABLED_CONNECTORS=gmail,github,codebase

# ---------- Credentials ----------
# Never put secrets here. Use the vault:
#   python vault.py set GITHUB_PERSONAL_ACCESS_TOKEN ghp_xxx --sensitive
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# ---------- Search ----------
TAVILY_API_KEY=

OBSIDIAN_VAULT=
