# Copy this file to .env and fill in your values.

# ---------- Provider ----------
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# ---------- Model slots ----------
MODEL_FAST=qwen2.5:3b
MODEL_BALANCED=quill
MODEL_POWERFUL=qwen2.5:7b
DEFAULT_SLOT=balanced

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
MAX_TOOL_ITERATIONS=8

# ---------- Filesystem ----------
WORKSPACE_ROOT=D:/Quill-Cowork/workspace

# ---------- Network ----------
# Comma-separated extra domains allowed for fetch_page
ALLOWED_DOMAINS=

# ---------- Credentials ----------
# Never commit real secrets. Use the vault instead (with --sensitive):
#   python vault.py set GITHUB_PERSONAL_ACCESS_TOKEN ghp_xxx --sensitive
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---------- Google OAuth (Gmail) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback