# Copy this file to .env and fill in your values.
# Never commit the filled-in .env.

# ---------- Provider ----------
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# ---------- Model slots ----------
# Seven slots the user can switch between from the UI.
# GPU slots are abliterated (uncensored) builds.
MODEL_FAST=huihui_ai/qwen3-abliterated:4b
MODEL_BALANCED=quill
MODEL_7B=quill-7b
MODEL_7B_REASON=quill-7b-reason
MODEL_POWERFUL=quill-7b-reason
MODEL_CPU_FAST=quill-cpu-fast
MODEL_CPU_SMART=quill-cpu-smart
DEFAULT_SLOT=7b

# Context window passed to Ollama. 8192 is safe on 8GB VRAM.
# Raise to 16384 or 32768 on 12GB+ cards when using the 7B/8B slots.
OLLAMA_NUM_CTX=8192

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
MAX_TOOL_ITERATIONS=20
MAX_PARALLEL_TOOLS=4

# ---------- Filesystem ----------
WORKSPACE_ROOT=D:/Quill-Cowork/workspace

# ---------- Network ----------
# Extra hosts that fetch_page may contact, comma-separated.
# The default allowlist covers GitHub, Google APIs, Wikipedia, Slack,
# Notion, Tavily, Brave, and DuckDuckGo.
ALLOWED_DOMAINS=

# ---------- Safety ----------
# Connector ids to hide. Comma-separated.
# Valid ids: filesystem, github, gmail, web, wikipedia, search,
#            grants, codebase, obsidian
DISABLED_CONNECTORS=

# ---------- Audio ----------
# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
# Device: auto, cpu, cuda
WHISPER_DEVICE=auto
# Compute type: leave blank for auto (int8 on CPU, float16 on CUDA)
WHISPER_COMPUTE=
# pyttsx3 speech rate
TTS_RATE=180

# ---------- Credentials ----------
# Never put secrets here. Use the vault:
#   python vault.py set GITHUB_PERSONAL_ACCESS_TOKEN ghp_xxx --sensitive
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---------- Google OAuth (Gmail) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# ---------- Search ----------
TAVILY_API_KEY=

# ---------- Obsidian ----------
# Path to your Obsidian vault folder (optional).
OBSIDIAN_VAULT=

# ---------- Debug ----------
# Set to 1 to log every audio control message on the server.
QUILL_AUDIO_DEBUG=0
# Set to 1 to allow WebSocket connections from non-localhost hosts
# when auth is disabled. Not recommended.
QUILL_ALLOW_LAN_NO_AUTH=0

# ---------- Semantic memory ----------
# Recall relevant past turns and inject them into the prompt.
# Requires:  ollama pull nomic-embed-text
MEMORY_ENABLED=1
MEMORY_MODEL=nomic-embed-text
MEMORY_TOP_K=5
MEMORY_MIN_SIM=0.45

# ---------- Critical fixes ----------
# Auto-approve tools up to this risk level (0 = read-only only).
AUTO_APPROVE_MAX_RISK=0
# Enable the sandboxed run_command tool. Requires Docker for hard isolation.
ENABLE_RUN_COMMAND=0

# ---------- Context compaction ----------
# Keep the model's working context under the window by summarizing
# old turns when usage crosses the threshold. The current turn is
# always preserved verbatim.
# CONTEXT_WINDOW should match OllamaProvider's num_ctx (default 8192).
CONTEXT_WINDOW=8192
CONTEXT_COMPACT_AT=0.85
CONTEXT_KEEP_RECENT=8
CONTEXT_AUTO=1
